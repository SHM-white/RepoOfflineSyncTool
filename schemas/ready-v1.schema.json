{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-offline-sync:ready-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "package_id", "manifest_sha256", "artifacts"],
  "properties": {
    "schema": {"const": "ready-v1"},
    "package_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?($|/))(?!.*//)[^\\u0000\\\\]+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "crc32", "byte_size"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "crc32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    }
  }
}
